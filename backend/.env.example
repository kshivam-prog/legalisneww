# AI Agreement Analyzer - Environment Configuration

# Application Settings
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./agreement_analyzer.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# File Upload
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=./uploads

# LLM Configuration
# Options: "mistralai/Mistral-7B-Instruct-v0.1", "meta-llama/Llama-2-7b-chat-hf", etc.
LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1
LLM_CACHE_DIR=./models

# Device Configuration
# Options: "cpu" (default), "cuda" (for NVIDIA GPU), "mps" (for Apple Silicon)
# GPU requires torch with cuda support installed
LLM_DEVICE=cpu

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Model Parameters
MAX_TOKENS=512
